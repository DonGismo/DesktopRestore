<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Per-User-Installation: keine Adminrechte, Programm unter %LocalAppData%\Programs\DesktopRestore.
       Die gespeicherten Layouts (%LocalAppData%\DesktopRestore) bleiben bei Deinstallation erhalten. -->
  <Package Name="DesktopRestore"
           Manufacturer="DesktopRestore"
           Version="$(var.ProductVersion)"
           UpgradeCode="7B3E9C2A-5D41-4F8E-9A6B-2C1D0E4F5A71"
           Scope="perUser"
           Language="1031"
           Codepage="1252"
           Compressed="yes">

    <SummaryInformation Description="DesktopRestore – Desktop-Icon-Anordnung pro Arbeitsplatz" />
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version von DesktopRestore ist bereits installiert." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.AssetsDir)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DesktopRestore" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="DesktopRestore">
      <!-- Programm -->
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="3F6B2D1E-8A47-4C59-B0E2-91D7C5A3E842">
        <File Id="DesktopRestoreExe" Source="$(var.AppPublishDir)\DesktopRestore.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\DesktopRestore" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveUserProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
      </Component>

      <!-- Autostart bei Anmeldung -->
      <Component Id="Autostart" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="DesktopRestore"
                       Type="string" Value="&quot;[INSTALLFOLDER]DesktopRestore.exe&quot;" KeyPath="yes" />
      </Component>

      <!-- Startmenü -->
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="AppShortcut" Name="DesktopRestore" Description="Desktop-Icon-Anordnung pro Arbeitsplatz"
                  Target="[INSTALLFOLDER]DesktopRestore.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\DesktopRestore" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- Laufende Instanz bei Update/Deinstallation beenden (WM_CLOSE an das versteckte Fenster) -->
    <util:CloseApplication Id="CloseRunningApp" Target="DesktopRestore.exe" CloseMessage="yes"
                           RebootPrompt="no" TerminateProcess="1" Timeout="5" />

    <!-- Nach der Installation starten -->
    <CustomAction Id="LaunchApplication" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]DesktopRestore.exe&quot;" Return="asyncNoWait" Execute="immediate" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
